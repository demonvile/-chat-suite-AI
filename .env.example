# ==========================================
# ENTERPRISE ENVIRONMENT CONFIGURATION
# ==========================================

# 1. CORE APPLICATION CONFIG
NODE_ENV="production"
PORT=3000
APP_URL="https://your-domain.com"
LOG_LEVEL="info" # debug, info, warn, error

# 2. AI SERVICE KEYS (Server-Side Only - Never expose to client)
# AI Studio automatically injects GEMINI_API_KEY and GROQ_API_KEY if available
GROQ_API_KEY="gsk_..."
GEMINI_API_KEY="AIzaSy..."
OPENAI_API_KEY="sk-..."
OPENROUTER_API_KEY="sk-or-v1-..."

# 3. SECURITY & AUTHENTICATION SECRETS
JWT_SECRET="e8b91f0a12c45d3e67890abcdef1234567890abcdef1234567890abcdef12345"
API_KEY_ENCRYPTION_KEY="enterprise-32-byte-encryption-secret-key-phrase"

# 4. RATE LIMITING & SECURITY SETTINGS
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
ALLOWED_CORS_ORIGINS="*"

# 5. DATABASE & STORAGE CONFIGURATION
DATABASE_URL="file:./data/db.json"
BACKUP_SCHEDULE_CRON="0 2 * * *" # Daily at 02:00 AM
MAX_BACKUP_RETENTION_COUNT=14

# 6. QUEUE & BACKGROUND WORKERS CONFIG
WORKER_CONCURRENCY=5
QUEUE_POLL_INTERVAL_MS=2000

# 7. REDIS / CACHE CONFIG (OPTIONAL SCALABILITY LAYER)
REDIS_URL="redis://localhost:6379"
CACHE_TTL_SECONDS=3600

# 8. STRIPE PAYMENT PROVIDER CONFIGURATION (Server-Side)
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
